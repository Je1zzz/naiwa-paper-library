{
  "manifest_version": 2,
  "name": "Paper Library · Obsidian Import Companion",
  "version": "0.1.1",
  "description": "Send selected Zotero bibliography items or PDF attachments to Paper Library in Obsidian.",
  "applications": {
    "zotero": {
      "id": "paper-library-obsidian@paper-library.local",
      "update_url": "https://raw.githubusercontent.com/Je1zzz/naiwa-paper-library/main/zotero-addon/updates.json",
      "strict_min_version": "7.0",
      "strict_max_version": "10.0.*"
    }
  }
}
